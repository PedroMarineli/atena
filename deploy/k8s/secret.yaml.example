apiVersion: v1
kind: Secret
metadata:
  name: atena-secrets
  namespace: atena
  labels:
    app.kubernetes.io/name: atena
    app.kubernetes.io/part-of: atena-erp
type: Opaque
stringData:
  # Replace with cryptographically strong keys before deployment
  SECRET_KEY: "change-this-to-a-very-long-and-secure-random-secret-key-at-least-50-chars"
  POSTGRES_DB: "atena_prod"
  POSTGRES_USER: "atena_app"
  POSTGRES_PASSWORD: "strong-random-db-password-example"
  DATABASE_URL: "postgres://atena_app:strong-random-db-password-example@postgres-service:5432/atena_prod"
