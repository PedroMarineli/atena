# Configurações do Django
SECRET_KEY=replace-this-with-a-secure-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.com

# Superusuário padrão para deploy automatizado
DJANGO_SUPERUSER_EMAIL=admin@atena.com
DJANGO_SUPERUSER_PASSWORD=admin

# Banco de Dados (Exemplo PostgreSQL)
DATABASE_URL=postgres://postgres:root@localhost:5432/atena
# Para desenvolvimento local com SQLite, use:
# DATABASE_URL=sqlite:///db.sqlite3

# Configurações para Produção (quando DEBUG=False)
# CSRF_TRUSTED_ORIGINS=https://seudominio.com
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
